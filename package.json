		"typescript": "^7.0"
	},
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": "./cjs/framework.js",
		"./property-select": "./cjs/property-select.js",
		"./property-select-actions": "./cjs/property-select-actions.js",
		"./property-select-list.js": "./property-select-list.js",
