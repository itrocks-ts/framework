	"name": "@itrocks/framework",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/itrocks-ts/framework.git"
	},
	"scripts": {
		"build": "npm run build:back && npm run build:front",
		"build:back": "tsc",
		"build:front": "tsc -p src/front/tsconfig.json && node -e \"const fs=require('node:fs');for(const file of fs.readdirSync('.').filter(file=>file.endsWith('.js')||file.endsWith('.d.ts')))fs.writeFileSync(file,fs.readFileSync(file,'utf8').replaceAll('../../',''))\"",
		"build:test": "tsc -p test/tsconfig.json",
		"test": "npm run build && npm run build:test && node --test test/*.test.js test/*.test.mjs"
	},
	"version": "1.3.0"
}
